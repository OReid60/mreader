{
  "name": "mreader",
  "version": "0.3.44",
  "private": true,
  "description": "Rust-powered desktop manga reader",
  "scripts": {
    "start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/desktop.ps1 run",
    "build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/desktop.ps1 build",
    "test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/desktop.ps1 test",
    "check": "node --check app.js && node --check features.js && node --check mobile.js && node tests/frontend.cjs && node tests/distribution-policy.cjs",
    "test:browse": "node tests/browse-source-errors.cjs",
    "test:mobile": "node tests/mobile-layout.cjs",
    "test:reader": "node tests/reader-strip.cjs",
    "test:offline": "node tests/offline-browse.cjs",
    "test:migration": "node tests/migration-layout.cjs && node tests/migration-guard.cjs"
  },
  "devDependencies": {
    "playwright": "1.65.1"
  }
}
